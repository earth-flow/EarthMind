# Terraflow Service Configuration
#
# This file tells LFX to use Terraflow's full-featured service implementations
# instead of the minimal/noop services built into LFX.
#
# Usage:
#   1. Copy this file to your TERRAFLOW_CONFIG_DIR as lfx.toml
#   2. Or add to pyproject.toml under [tool.lfx.services]
#
# The services will be automatically discovered and loaded when you run:
#   - terraflow run
#   - lfx serve (when run from terraflow project)

[services]
# Core Services - Full-featured Terraflow implementations
database_service = "terraflow.services.database.service:DatabaseService"
storage_service = "terraflow.services.storage.local:LocalStorageService"
cache_service = "terraflow.services.cache.service:ThreadingInMemoryCache"

# Authentication & Session Management
auth_service = "terraflow.services.auth.service:AuthService"
session_service = "terraflow.services.session.service:SessionService"

# Chat & Communication
chat_service = "terraflow.services.chat.service:ChatService"

# State & Data Management
state_service = "terraflow.services.state.service:StateService"
variable_service = "terraflow.services.variable.service:VariableService"

# Background Processing
task_service = "terraflow.services.task.service:TaskService"
job_queue_service = "terraflow.services.job_queue.service:JobQueueService"

# Marketplace & Components
store_service = "terraflow.services.store.service:StoreService"
shared_component_cache_service = "terraflow.services.shared_component_cache.service:SharedComponentCacheService"

# Observability
telemetry_service = "terraflow.services.telemetry.service:TelemetryService"
tracing_service = "terraflow.services.tracing.service:TracingService"

# Note: settings_service is NOT configurable - it always uses the built-in implementation
# Note: mcp_composer_service uses the lfx implementation by default
