# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file

# Config directory
# Directory where files, logs and database will be stored
# Example: TERRAFLOW_CONFIG_DIR=~/.terraflow
TERRAFLOW_CONFIG_DIR=

# Save database in the config directory
# Values: true, false
# If false, the database will be saved in Terraflow's root directory
# This means that the database will be deleted when Terraflow is uninstalled
# and that the database will not be shared between different virtual environments
# Example: TERRAFLOW_SAVE_DB_IN_CONFIG_DIR=true
TERRAFLOW_SAVE_DB_IN_CONFIG_DIR=

# Database URL
# Postgres example: TERRAFLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terraflow  # pragma: allowlist secret
# SQLite example:
TERRAFLOW_DATABASE_URL=sqlite:///./terraflow.db

# Alembic logs path flag. If set to true, Alembic will log to stdout.
TERRAFLOW_ALEMBIC_LOG_TO_STDOUT=False

# mem0 creates a directory
# for chat history, vector stores, and other artifacts
# its default path is ~/.mem0.
# we can change this path with
# environment variable "MEM0_DIR"
# Example: MEM0_DIR=/tmp/.mem0

# composio creates a cache directory
# for file uploads/downloads.
# its default path is ~/.composio
# we can change this path with
# environment variable "COMPOSIO_CACHE_DIR"
# Example: COMPOSIO_CACHE_DIR=/tmp/.composio


# Database connection retry
# Values: true, false
# If true, the database will retry to connect to the database if it fails
# Example: TERRAFLOW_DATABASE_CONNECTION_RETRY=true
TERRAFLOW_DATABASE_CONNECTION_RETRY=false

# Cache type
TERRAFLOW_LANGCHAIN_CACHE=SQLiteCache

# Server host
# Example: TERRAFLOW_HOST=localhost
TERRAFLOW_HOST=

# Worker processes
# Example: TERRAFLOW_WORKERS=1
TERRAFLOW_WORKERS=

# Server port
# Example: TERRAFLOW_PORT=7860
TERRAFLOW_PORT=

# Logging level
# Example: TERRAFLOW_LOG_LEVEL=critical
TERRAFLOW_LOG_LEVEL=

# Path to the log file
# Example: TERRAFLOW_LOG_FILE=logs/terraflow.log
TERRAFLOW_LOG_FILE=

# Time/Size for log to rotate
# Example: TERRAFLOW_LOG_ROTATION=‘10 MB’/‘1 day’
TERRAFLOW_LOG_ROTATION=

# Path to the frontend directory containing build files
# Example: TERRAFLOW_FRONTEND_PATH=/path/to/frontend/build/files
TERRAFLOW_FRONTEND_PATH=

# Whether to open the browser after starting the server
# Values: true, false
# Example: TERRAFLOW_OPEN_BROWSER=true
TERRAFLOW_OPEN_BROWSER=

# Whether to remove API keys from the projects saved in the database
# Values: true, false
# Example: TERRAFLOW_REMOVE_API_KEYS=false
TERRAFLOW_REMOVE_API_KEYS=

# Whether to use RedisCache or ThreadingInMemoryCache or AsyncInMemoryCache
# Values: async, memory, redis
# Example: TERRAFLOW_CACHE_TYPE=memory
# If you want to use redis then the following environment variables must be set:
# TERRAFLOW_REDIS_HOST (default: localhost)
# TERRAFLOW_REDIS_PORT (default: 6379)
# TERRAFLOW_REDIS_DB (default: 0)
# TERRAFLOW_REDIS_CACHE_EXPIRE (default: 3600)
TERRAFLOW_CACHE_TYPE=

# Set TERRAFLOW_AUTO_LOGIN to false if you want to disable auto login
# and use the login form to login. TERRAFLOW_SUPERUSER and TERRAFLOW_SUPERUSER_PASSWORD
# must be set if AUTO_LOGIN is set to false
# Values: true, false
TERRAFLOW_AUTO_LOGIN=

# SET TERRAFLOW_ENABLE_SUPERUSER_CLI to false to disable
# superuser creation via the CLI
TERRAFLOW_ENABLE_SUPERUSER_CLI=

# Superuser username
# Example: TERRAFLOW_SUPERUSER=admin
TERRAFLOW_SUPERUSER=

# Superuser password
# Example: TERRAFLOW_SUPERUSER_PASSWORD=123456
TERRAFLOW_SUPERUSER_PASSWORD=

# API Key Source
# Controls how API keys are validated for the x-api-key header
# Values: db, env
# - db (default): Validates against API keys stored in the database
# - env: Validates against the TERRAFLOW_API_KEY environment variable
# Example: TERRAFLOW_API_KEY_SOURCE=db
TERRAFLOW_API_KEY_SOURCE=

# API Key (only used when TERRAFLOW_API_KEY_SOURCE=env)
# The API key to use for authentication when API_KEY_SOURCE is set to 'env'
# This allows injecting a pre-defined API key via environment variables
# (useful for Kubernetes Secrets, CI/CD pipelines, etc.)
# Example: TERRAFLOW_API_KEY=your-secure-api-key
TERRAFLOW_API_KEY=

# Rate Limiting Configuration
# Controls rate limiting for login endpoint to prevent brute force attacks
# TERRAFLOW_RATE_LIMIT_PER_MINUTE: Number of login attempts allowed per minute per IP
# Values: positive integer (default: 5)
# Example: TERRAFLOW_RATE_LIMIT_PER_MINUTE=10
TERRAFLOW_RATE_LIMIT_PER_MINUTE=

# TERRAFLOW_RATE_LIMIT_STORAGE_URI: Storage backend for rate limit counters
# Values: memory:// (default, single server) or redis://host:port (production, multiple servers)
# - memory://: Fast, in-memory storage (not shared between server instances, lost on restart)
# - redis://localhost:6379: Persistent, shared storage (required for load-balanced deployments)
# Example: TERRAFLOW_RATE_LIMIT_STORAGE_URI=redis://localhost:6379
TERRAFLOW_RATE_LIMIT_STORAGE_URI=

# TERRAFLOW_RATE_LIMIT_TRUST_PROXY: Trust X-Forwarded-For header for client IP
# Values: true, false (default: false)
# When true, uses rightmost X-Forwarded-For IP (the trusted proxy before us)
# When false, uses direct connection IP (prevents header spoofing in non-proxy deployments)
#
# SECURITY WARNING: Only enable if behind a trusted proxy (nginx, load balancer, etc.)
# This setting controls BOTH the application rate limiter AND uvicorn's proxy header processing.
# When false (default), uvicorn will NOT trust X-Forwarded-For headers, preventing IP spoofing.
# When true, uvicorn trusts ALL proxy headers - ensure your proxy is properly configured to
# prevent client-supplied X-Forwarded-For values from reaching Terraflow.
#
# Example: TERRAFLOW_RATE_LIMIT_TRUST_PROXY=true
TERRAFLOW_RATE_LIMIT_TRUST_PROXY=

# Should store environment variables in the database
# Values: true, false
TERRAFLOW_STORE_ENVIRONMENT_VARIABLES=

# SSRF (Server-Side Request Forgery) Protection
# When enabled, blocks requests to private IP ranges, localhost, and cloud metadata endpoints
# Values: true, false
# Default: false (for backward compatibility)
# Set to true to enable protection against SSRF attacks
TERRAFLOW_SSRF_PROTECTION_ENABLED=

# SSRF Allowed Hosts
# Comma-separated list of hosts/IPs/CIDR ranges to allow despite SSRF protection
# Supports: exact hostnames, wildcard domains (*.example.com), exact IPs, CIDR ranges
# Example: TERRAFLOW_SSRF_ALLOWED_HOSTS=internal-api.company.local,192.168.1.0/24,*.dev.internal
# Note: Only takes effect when TERRAFLOW_SSRF_PROTECTION_ENABLED=true
TERRAFLOW_SSRF_ALLOWED_HOSTS=

# Should enable the MCP composer feature in MCP projects
# Values: true, false
# Default: true
TERRAFLOW_MCP_COMPOSER_ENABLED=

# STORE_URL
# Example: TERRAFLOW_STORE_URL=https://api.terraflow.store
# TERRAFLOW_STORE_URL=

# DOWNLOAD_WEBHOOK_URL
#
# TERRAFLOW_DOWNLOAD_WEBHOOK_URL=

# LIKE_WEBHOOK_URL
#
# TERRAFLOW_LIKE_WEBHOOK_URL=

# Value must finish with slash /
#BACKEND_URL=http://localhost:7860/
BACKEND_URL=
